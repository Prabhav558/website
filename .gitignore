# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
dist-ssr/
build/
out/

# Vite / TypeScript caches
node_modules/.vite/
.vite/
*.tsbuildinfo
.eslintcache
.cache/
.parcel-cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Environment files (keep the example template tracked)
.env
.env.*
!.env.example

# Test coverage
coverage/
.nyc_output/

# Editors (keep shared VS Code settings if present)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local scratch / screenshots
*.local
*.tmp
*.bak
